{
  "schemaVersion": 1,
  "id": "siris",
  "version": "${version}",
  "name": "SIRIS",
  "description": "NVIDIA DLSS Super Resolution and Frame Generation for Minecraft 26.3, integrated with the game's Vulkan renderer and Vitrail shader packs.",
  "authors": [
    "laurensanp"
  ],
  "contact": {
    "sources": "https://github.com/laurensanp/siris",
    "issues": "https://github.com/laurensanp/siris/issues"
  },
  "license": "MIT",
  "icon": "assets/siris/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.siris.Siris"
    ],
    "sodium:config_api_user": [
      "com.siris.SodiumOptions"
    ],
    "modmenu": [
      "com.siris.ModMenuIntegration"
    ]
  },
  "mixins": [
    "siris.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "26.3"
  },
  "breaks": {
    "resolutionscaler": "*"
  },
  "suggests": {
    "modmenu": "*",
    "vitrail": "*"
  }
}
